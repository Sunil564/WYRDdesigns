# The production domain is not registered yet. See docs/BLOCKERS.md item 1.
# Intended value once it exists: https://wyrddesigns.in
# Leave unset locally, lib/site-url.ts falls back to http://localhost:3000, then
# to the Vercel deployment URL when deployed.
NEXT_PUBLIC_SITE_URL=

# Resend, for the contact form. Delivery goes to hello@wyrddesigns.in.
#
# Without this the form does not silently succeed. It tells the visitor the message has not
# gone through, offers the direct address, and logs a line on the server naming this variable.
# Verified by scripts/check-contact.mjs, which runs that path deliberately.
#
# The sender is onboarding@resend.dev until the production domain exists and can be verified
# with Resend. See docs/BLOCKERS.md items 1 and 9.
RESEND_API_KEY=
