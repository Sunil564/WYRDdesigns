{
  "name": "wyrd-site",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:dashes": "python scripts/check-dashes.py",
    "check:shell": "node scripts/check-shell.mjs",
    "check:tiers": "node scripts/check-tiers.mjs",
    "check:hero": "node scripts/check-hero.mjs",
    "shoot": "node scripts/shoot.mjs",
    "assets": "python scripts/process-assets.py",
    "verify": "npm run check:dashes && npm run typecheck && npm run lint && npm run build"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.3.1",
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.7.0",
    "@types/mdx": "^2.0.14",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "gsap": "3.15.0",
    "lenis": "1.3.26",
    "lucide-react": "1.33.0",
    "motion": "13.1.0",
    "next": "15.5.23",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.21.0",
    "three": "0.180.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/three": "0.180.0",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.23",
    "lighthouse": "^12.8.2",
    "playwright": "^1.62.1",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
